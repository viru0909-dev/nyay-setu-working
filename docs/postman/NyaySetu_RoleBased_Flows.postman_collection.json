      "item": [
        {
          "name": "Login Judge",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"judge@nyaysetu.in\",\n  \"password\": \"Pass@1234\"\n}"
