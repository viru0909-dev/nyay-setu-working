              "raw": "{\n  \"email\": \"police@nyaysetu.in\",\n  \"password\": \"Pass@1234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
