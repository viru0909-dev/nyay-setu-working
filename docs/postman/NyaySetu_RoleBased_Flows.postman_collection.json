            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"findings\": \"Investigation complete. Sufficient evidence against accused.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/police/investigation/{{firId}}/submit",
